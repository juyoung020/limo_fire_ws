<?xml version="1.0" ?>
<!-- limo_fire 판: 교수님 webots_ros2_limo/resource/limo.urdf 에 인식 벤치마크 정답 카메라 플러그인만 더함 (sim_robot.launch.xml 이 씀) -->
<robot name="LIMO">
    <webots>
        <!-- Turn off the driver's automatic /LIMO/<device> topics: the plugin below
             publishes the real robot's topics instead. -->
        <device reference="laser"><ros><enabled>false</enabled></ros></device>
        <device reference="rgb_camera"><ros><enabled>false</enabled></ros></device>
        <device reference="depth_camera"><ros><enabled>false</enabled></ros></device>
        <device reference="ir_camera"><ros><enabled>false</enabled></ros></device>
        <device reference="imu compass"><ros><enabled>false</enabled></ros></device>
        <!-- limo_fire: 초음파 HC-SR04 × 3 (월드에서 LimoFire ultrasonic TRUE 일 때만 있음) → sensor_msgs/Range, 실물 ESP32 다리와 같은 토픽·프레임.
             10 Hz: 셋을 차례로 쏘는 실물(간섭 — docs/spec.md) 주기에 맞춤 (잠정) -->
        <device reference="sonar_front"><ros><topicName>/ultrasonic/front</topicName><frameName>ultrasonic_front_link</frameName><updateRate>10</updateRate><alwaysOn>true</alwaysOn></ros></device>
        <device reference="sonar_left"><ros><topicName>/ultrasonic/left</topicName><frameName>ultrasonic_left_link</frameName><updateRate>10</updateRate><alwaysOn>true</alwaysOn></ros></device>
        <device reference="sonar_right"><ros><topicName>/ultrasonic/right</topicName><frameName>ultrasonic_right_link</frameName><updateRate>10</updateRate><alwaysOn>true</alwaysOn></ros></device>

        <!-- /scan, /imu and all /camera/* topics, published with the same names, types,
             frames, rates and QoS as the real LIMO (see webots_ros2_limo/limo_sensors.py). -->
        <plugin type="webots_ros2_limo.limo_sensors.LimoSensors" />

        <plugin type="webots_ros2_control::Ros2Control" />

        <!-- limo_fire: 인식 벤치마크 정답 (limo_fire_sim GtCamera). /gt/* 를 받는 쪽이 있을 때만 켠다.
             자르기·크기는 limo_sensors.py 의 COLOR_CROP (44, 4) · 640×480 과 같게, 클래스는 train/detect 순서 -->
        <plugin type="limo_fire_sim::GtCamera">
            <cameraName>rgb_camera</cameraName>
            <topicName>/gt</topicName>
            <periodMs>30</periodMs>
            <cropTop>44</cropTop>
            <cropLeft>4</cropLeft>
            <width>640</width>
            <height>480</height>
            <minPixels>30</minPixels>
            <frameId>camera_color_optical_frame</frameId>
            <syncTopic>/camera/color/camera_info</syncTopic>
            <classNames>fire,smoke,fire_extinguisher,exit_sign,person,door,stairs</classNames>
        </plugin>
        <!-- limo_fire: 시뮬 정답 자세 (limo_fire_sim GroundTruthPose) — 월드에서 LIMO 가 supervisor TRUE 일 때만 켜진다.
             Webots 세계 좌표 그대로(원점 보정 0). 지도 좌표 변환은 받는 쪽이 월드 데이터 파일 robot_start 로 (nav_benchmark).
             위치 추정에는 절대 쓰지 않는다 — 평가 전용 -->
        <plugin type="limo_fire_sim::GroundTruthPose">
            <originX>0.0</originX>
            <originY>0.0</originY>
            <periodMs>50</periodMs>
            <frameId>webots_world</frameId>
            <topicName>/sim/ground_truth</topicName>
        </plugin>
    </webots>

    <ros2_control name="WebotsControl" type="system">
        <hardware>
            <plugin>webots_ros2_control::Ros2ControlSystem</plugin>
        </hardware>
        <joint name="front_left_wheel">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <command_interface name="velocity"/>
        </joint>
        <joint name="front_right_wheel">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <command_interface name="velocity"/>
        </joint>
        <joint name="rear_left_wheel">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <command_interface name="velocity"/>
        </joint>
        <joint name="rear_right_wheel">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <command_interface name="velocity"/>
        </joint>
    </ros2_control>
</robot>
