<!-- 우리 노드 전부를 한 프로세스 · 한 스레드에 (컨테이너 /app, rclcpp component_container = 한 스레드 실행기, 프로세스 안 전달 켬).
     먼저 로봇 드라이버: ros2 launch limo_fire_bringup robot.launch.xml   (센서·섀시·EKF — 따로 프로세스)
     그리고 판단 모델 서버(llama-server, limo_fire_explore/README "위층 판단 모델 띄우기").
       ros2 launch limo_fire_explore app.launch.xml [perception:=true] [stack:=true] [rviz:=true] [dry_run:=false]
     /app 안:  /explore/explorer (탐사: 위층 판단 모델 + 아래층 A*)
               + perception:=true 면 /perception/object_detector (YOLO, GPU 비동기) · /perception/object_map (물체 지도)
     흐름: 카메라 → object_detector → (탐지·마스크, 복사 없음) → object_map → /perception/objects → explorer → /cmd_vel
     늘 꺼진 채 뜬다 → RViz 탐사 패널 "합친 탐사" 또는 ros2 service call /explore/enable std_srvs/srv/SetBool "{data: true}" (리모컨 오토일 때만)
     "○○ 로 가": ros2 topic pub -1 /explore/goal std_msgs/msg/String "{data: '의자'}" (빈 글 = 지움) · 진행 /explore/goal_status -->
<launch>
  <arg name="dry_run" default="true" description="true: /cmd_vel 안 냄 (/explore/cmd_debug 에만) · false: 실제 주행"/>
  <arg name="perception" default="false" description="true: YOLO 탐지 + 물체 지도를 같은 프로세스에 (찾은 물체가 지도에 남고 '○○ 로 가' 후보가 됨)"/>
  <arg name="stack" default="false" description="true: Cartographer(지도 TF map → odom) 같이"/>
  <arg name="rviz" default="false" description="true: 운용 화면 RViz (limo_fire_description viewer.launch.xml · limo_fire.rviz 하나 — 탐사 패널·후보·판단 모델 입력 지도 포함)"/>
  <arg name="debug" default="$(var rviz)" description="true: RViz 표시 토픽(/explore/candidates …)도 냄 — 기본은 rviz 와 같음"/>
  <arg name="record" default="" description="입력·명령 녹화 파일 (비우면 안 씀 — low_explore_replay 로 다시 돌림)"/>
  <arg name="perception_config" default="yolo_coco.yaml" description="인식 설정 (limo_fire_perception/config): yolo_coco.yaml (COCO 80 종) · yolo_fire.yaml (화재 7 종)"/>
  <arg name="objects_file" default="" description="물체 지도 파일 (있으면 켤 때 읽음)"/>
  <arg name="camera_in_app" default="false" description="true: 카메라 드라이버(Orbbec)를 /app 안에 — 카메라 → 우리 노드가 공유 메모리·UDP 없이 프로세스 안. robot.launch.xml camera:=false 와 같이"/>
  <arg name="gpu_thread" default="false" description="true: YOLO 를 옛 작업 스레드 판으로 (로봇에서 실행기 판 확인 전 대비) — TODO(제거)"/>

  <group if="$(var stack)">
    <include file="$(find-pkg-share limo_fire_bringup)/launch/mapping.launch.xml">
      <arg name="rviz" value="false"/>
    </include>
  </group>

  <!-- CUDA 커널을 쓸 때만 올림(지연 로딩): GPU·CPU 메모리를 줄인다 -->
  <set_env name="CUDA_MODULE_LOADING" value="LAZY"/>
  <node_container pkg="rclcpp_components" exec="component_container" name="app" namespace="" output="screen">
    <composable_node pkg="limo_fire_explore" plugin="limo_fire_explore::ExplorerNode" name="explorer" namespace="explore">
      <param from="$(find-pkg-share limo_fire_explore)/config/explorer.yaml"/>
      <param name="dry_run" value="$(var dry_run)"/>
      <param name="debug" value="$(var debug)"/>
      <param name="record" value="$(var record)"/>
      <extra_arg name="use_intra_process_comms" value="true"/>
    </composable_node>
  </node_container>

  <!-- load_composable_node 는 if 를 무시하므로 group 으로 조건을 건다 -->
  <group if="$(var perception)">
    <load_composable_node target="/app">
      <composable_node pkg="limo_fire_perception" plugin="limo_fire_perception::ObjectDetectorNode" name="object_detector" namespace="perception">
        <param from="$(find-pkg-share limo_fire_perception)/config/$(var perception_config)"/>
        <param name="gpu_thread" value="$(var gpu_thread)"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
      <composable_node pkg="limo_fire_perception" plugin="limo_fire_perception::ObjectMapNode" name="object_map" namespace="perception">
        <param from="$(find-pkg-share limo_fire_perception)/config/$(var perception_config)"/>
        <param name="objects_file" value="$(var objects_file)"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
    </load_composable_node>
  </group>

  <!-- 카메라를 /app 안에 (camera_in_app:=true, robot.launch.xml camera:=false 와 짝). 이 노드만 프로세스 안 전달을 끔: 드라이버가 transient_local 발행자
       (depth_to_color 등)를 만들어 켜면 rclcpp 가 거부. 그래도 같은 DDS 참가자 안이라 Fast DDS 가 프로세스 안으로 바로 넘김(공유 메모리·UDP 안 거침).
       대가: 카메라 SDK 가 죽으면 /app(탐사·인식)도 같이 죽음. 로봇 시험 차례는 docs/runtime_io.md "카메라를 /app 에" -->
  <group if="$(var camera_in_app)">
    <load_composable_node target="/app">
      <composable_node pkg="orbbec_camera" plugin="orbbec_camera::OBCameraNodeDriver" name="camera" namespace="camera">
        <param from="$(find-pkg-share limo_fire_bringup)/config/orbbec_dabai_dc1.yaml"/>
        <extra_arg name="use_intra_process_comms" value="false"/>
      </composable_node>
    </load_composable_node>
  </group>

  <!-- 운용 화면은 하나(limo_fire.rviz): 순찰·주행·탐사가 같은 창 -->
  <include file="$(find-pkg-share limo_fire_description)/launch/viewer.launch.xml" if="$(var rviz)"/>
</launch>
