<!-- 카메라 영상에서 YOLO 탐지 (실물·Webots 공용). 결과: /yolo_detector/detections, 상자 그린 영상: /yolo_detector/image
     mapper:=true 면 탐지 + 깊이로 물체를 지도(map)에 올린다 → RViz MarkerArray /object_mapper/markers
     rviz:=true 면 운용 화면(limo_fire_description viewer.launch.xml: 지도 + 물체 + 탐지 영상 + Nav2)
     두 노드는 컴포넌트로 한 프로세스(멀티스레드 컨테이너)에 올리고 프로세스 안 전달(intra-process)로 탐지·마스크를 복사 없이 넘긴다.
     new_container:=false container:=<이름> 이면 이미 있는 컨테이너에 올린다
     모델은 config 로 고른다: yolo_coco.yaml(COCO 80 종 분할, 기본) · yolo_fire.yaml(우리 화재 7 종 분할). objects_file 이 있으면 켤 때 그 물체 지도를 읽는다
     ros2 launch limo_fire_perception yolo.launch.xml [config:=yolo_coco.yaml|yolo_fire.yaml] [mapper:=true] [rviz:=true] [objects_file:=…]
     navigation.launch.xml 처럼 운용 화면을 이미 띄운 launch 와 같이 켤 때는 rviz:=false -->
<launch>
  <arg name="config" default="yolo_coco.yaml" description="모델 설정: yolo_coco.yaml (COCO 80 종) · yolo_fire.yaml (화재 7 종)"/>
  <arg name="params_override" default="$(find-pkg-share limo_fire_perception)/config/$(var config)" description="config 위에 덮어쓸 파라미터 (벤치마크: benchmark.yaml)"/>
  <arg name="mapper" default="true" description="탐지한 물체를 지도 좌표로 (map 프레임 TF 필요: SLAM 또는 AMCL)"/>
  <arg name="rviz" default="true" description="운용 화면(탐지 영상 + 지도 위 물체 + Nav2)"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="new_container" default="true" description="false 면 container 로 준 이미 있는 컨테이너에 올린다"/>
  <arg name="container" default="/perception_container"/>
  <arg name="search" default="false" description="설명 글로 물체 찾기(SigLIP2, object_search) — 엔진을 만든 뒤 true"/>
  <arg name="embeddings_file" default="" description="SigLIP2 물체 사진 벡터 파일 (물체 지도 파일과 같이 쓰는 &lt;이름&gt;_objects.emb)"/>
  <arg name="objects_file" default="" description="물체 지도 파일 (있으면 켤 때 읽음 · ~/save 로 씀). 저장 지도 옆 &lt;이름&gt;_objects.txt"/>

  <node_container pkg="rclcpp_components" exec="component_container_mt" name="perception_container" namespace=""
                  output="screen" if="$(var new_container)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node_container>

  <load_composable_node target="$(var container)">
    <composable_node pkg="limo_fire_perception" plugin="limo_fire_perception::YoloDetectorNode" name="yolo_detector" namespace="">
      <param from="$(find-pkg-share limo_fire_perception)/config/$(var config)"/>
      <param from="$(var params_override)"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <extra_arg name="use_intra_process_comms" value="true"/>
    </composable_node>
  </load_composable_node>
  <!-- load_composable_node 는 if 를 무시하므로 group 으로 조건을 건다 -->
  <group if="$(var mapper)">
    <load_composable_node target="$(var container)">
      <composable_node pkg="limo_fire_perception" plugin="limo_fire_perception::ObjectMapperNode" name="object_mapper" namespace="">
        <param from="$(find-pkg-share limo_fire_perception)/config/$(var config)"/>
        <param name="objects_file" value="$(var objects_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
    </load_composable_node>
  </group>

  <!-- 설명 글로 물체 찾기 (SigLIP2 — 엔진·토큰 표는 README "SigLIP2"). search:=true 일 때만 -->
  <group if="$(var search)">
    <load_composable_node target="$(var container)">
      <composable_node pkg="limo_fire_perception" plugin="limo_fire_perception::ObjectSearchNode" name="object_search" namespace="">
        <param name="embeddings_file" value="$(var embeddings_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
      </composable_node>
    </load_composable_node>
  </group>

  <include file="$(find-pkg-share limo_fire_description)/launch/viewer.launch.xml" if="$(var rviz)">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>
</launch>
