<!-- 카메라 영상에서 YOLO 탐지 (실물·Webots 공용). 결과: /yolo_detector/detections, 상자 그린 영상: /yolo_detector/image
     mapper:=true 면 탐지 + 깊이로 물체를 지도(map)에 올린다 → RViz MarkerArray /object_mapper/markers
     rviz:=true 면 지도 + 물체 마커 + 탐지 영상을 한 RViz 창에 (limo_fire_description/rviz/object_map.rviz)
     두 노드는 컴포넌트로 한 프로세스(멀티스레드 컨테이너)에 올리고 프로세스 안 전달(intra-process)로 탐지·마스크를 복사 없이 넘긴다.
     new_container:=false container:=<이름> 이면 이미 있는 컨테이너에 올린다
     ros2 launch limo_fire_perception yolo.launch.xml [viewer:=true] [mapper:=true] [rviz:=true] -->
<launch>
  <arg name="config" default="yolo_fire.yaml"/>
  <arg name="viewer" default="true" description="rqt_image_view 로 탐지 영상 보기"/>
  <arg name="mapper" default="true" description="탐지한 물체를 지도 좌표로 (map 프레임 TF 필요: SLAM 또는 AMCL)"/>
  <arg name="rviz" default="false" description="지도 위 물체 RViz"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="new_container" default="true" description="false 면 container 로 준 이미 있는 컨테이너에 올린다"/>
  <arg name="container" default="/perception_container"/>

  <node_container pkg="rclcpp_components" exec="component_container_mt" name="perception_container" namespace=""
                  output="screen" if="$(var new_container)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node_container>

  <load_composable_node target="$(var container)">
    <composable_node pkg="limo_fire_perception" plugin="limo_fire_perception::YoloDetectorNode" name="yolo_detector" namespace="">
      <param from="$(find-pkg-share limo_fire_perception)/config/$(var config)"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <extra_arg name="use_intra_process_comms" value="true"/>
    </composable_node>
  </load_composable_node>
  <!-- load_composable_node 는 if 를 무시하므로 group 으로 조건을 건다 -->
  <group if="$(var mapper)">
    <load_composable_node target="$(var container)">
      <composable_node pkg="limo_fire_perception" plugin="limo_fire_perception::ObjectMapperNode" name="object_mapper" namespace="">
        <param from="$(find-pkg-share limo_fire_perception)/config/$(var config)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
    </load_composable_node>
  </group>

  <node pkg="rqt_image_view" exec="rqt_image_view" name="yolo_viewer" args="/yolo_detector/image" if="$(var viewer)"/>
  <node pkg="rviz2" exec="rviz2" name="object_map_rviz" if="$(var rviz)"
        args="-d $(find-pkg-share limo_fire_description)/rviz/object_map.rviz">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
