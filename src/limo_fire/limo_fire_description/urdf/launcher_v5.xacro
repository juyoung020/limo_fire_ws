<?xml version="1.0"?>
<!-- 탁구공 발사대 v5 (주영 설계: juyoung020/limo_fire_ws hardware/modeling/탁구공발사대/v5, origin/main a22cf08).
     TF: <parent> → launcher_pivot (상하 회전축, 차체에 고정) → launcher_pitch_joint → launcher_link → launcher_muzzle
     - launcher_pivot: 회전축 중심. 조준 노드(approach_aim)가 이 프레임으로 장착 위치·방향을 읽는다. 장착 값은 limo_fire.urdf.xacro 한 곳에서 준다.
     - launcher_pitch_joint: 각도 θ 가 클수록 총구가 들린다(CAD build_cradle.py: p → Ry(-θ)(p - AX) + 축). 그래서 축은 -y.
       범위 5~30° = CAD ANG·펌웨어 범위. 힘·속도 = 각도 서보 MG996R 9.4 kg·cm, 60°/0.17 s (CAD sim_full.py SERVOS).
     - launcher_muzzle: 총구(총신 축 위 앞 끝). 발사대 자기 좌표(params.json)에서 축 AX = (x -40, z -45) mm, 총구 X_MUZ = 25.7 mm, 총신 축 z = 0
       → 축 기준 (65.7, 0, 45) mm (θ = 0 에서 총신 수평).
     겉모양은 CAD 치수로 만든 단순 도형이다(출력용 STL 은 출력 자세라 조립 좌표가 아님). 총신 X_REAR -104 ~ X_MUZ 25.7 mm, 바깥 반지름 23.2 mm,
     받침대(roof_cradle) 지붕 좌표 x -69~37, y -54~46, z 0~77 mm 를 축(지붕 x -25, z 62) 기준으로 옮김. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="launcher_v5" params="parent xyz yaw">
    <joint name="launcher_pivot_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="launcher_pivot"/>
      <origin xyz="${xyz}" rpy="0 0 ${yaw}"/>
    </joint>
    <link name="launcher_pivot">
      <visual>
        <origin xyz="0.009 -0.004 -0.0235" rpy="0 0 0"/>
        <geometry><box size="0.106 0.100 0.077"/></geometry>
        <material name="launcher_cradle"><color rgba="0.30 0.34 0.39 1"/></material>
      </visual>
    </link>

    <joint name="launcher_pitch_joint" type="revolute">
      <parent link="launcher_pivot"/>
      <child link="launcher_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${radians(5.0)}" upper="${radians(30.0)}" effort="0.92" velocity="6.16"/>
    </joint>
    <link name="launcher_link">
      <visual>
        <origin xyz="0.00085 0 0.045" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="0.0232" length="0.1297"/></geometry>
        <material name="launcher_body"><color rgba="0.72 0.75 0.78 1"/></material>
      </visual>
    </link>

    <joint name="launcher_muzzle_joint" type="fixed">
      <parent link="launcher_link"/>
      <child link="launcher_muzzle"/>
      <origin xyz="0.0657 0 0.045" rpy="0 0 0"/>
    </joint>
    <link name="launcher_muzzle"/>
  </xacro:macro>
</robot>
