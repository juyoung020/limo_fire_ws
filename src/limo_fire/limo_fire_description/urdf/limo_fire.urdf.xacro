<?xml version="1.0"?>
<!-- 화재 대응 LIMO Pro 조립. 모듈마다 xacro 하나, 장착 위치는 여기 한 곳에만 둔다.
     열화상·레이더·노즐(팬·틸트)은 배치가 정해지면 모듈 xacro 를 더하고 여기서 부른다.
     xacro limo_fire.urdf.xacro platform:=real camera_pitch:=0.0 camera_driver_tf:=false -->
<robot name="limo_fire" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- real: 실물 LIMO, webots: 교수님 Webots 모델(webots_ros2_limo LimoFourDiff.proto). 둘이 다른 장착 위치만 여기서 고른다 -->
  <xacro:arg name="platform" default="real"/>
  <!-- 카메라 마운트 틸트(라디안, 아래로 숙이면 +). 손으로 고정하는 마운트라 관절이 아니라 인자로 받는다 -->
  <xacro:arg name="camera_pitch" default="0.0"/>
  <!-- true: camera_link 아래 color·depth 프레임은 카메라 드라이버가 낸다 (실물 Orbbec 드라이버, Webots limo_sensors 플러그인 둘 다) -->
  <xacro:arg name="camera_driver_tf" default="false"/>

  <xacro:include filename="$(find limo_fire_description)/urdf/limo_pro_base.xacro"/>
  <xacro:include filename="$(find limo_fire_description)/urdf/orbbec_dabai.xacro"/>
  <xacro:include filename="$(find limo_fire_description)/urdf/ultrasonic.xacro"/>
  <xacro:include filename="$(find limo_fire_description)/urdf/webots_control.xacro"/>

  <xacro:limo_pro_base/>

  <!-- base_link → camera_link
       real:   x·y 는 실물 실측(약 0.15, −0.005). z 0.0431 = 실측 광축 높이 0.1881 m − base_link 0.145 m (train/explore/sim/analysis/real_limo.md 깊이 절, static_1103_floor 맞춤·1103_M_drive1 확인). 이전 값: WeGo 0.06
       webots: Webots 모델의 깊이 렌즈 자리 (LimoFourDiff.proto 주석) -->
  <xacro:property name="camera_xyz" value="${dict(real='0.15 -0.005 0.0431', webots='0.096 0.015 0.03')['$(arg platform)']}"/>
  <xacro:orbbec_dabai parent="base_link" name="camera" xyz="${camera_xyz}"
                      pitch="$(arg camera_pitch)" driver_tf="$(arg camera_driver_tf)"/>

  <!-- 초음파 HC-SR04 × 2 (연기 모드, docs/smoke_mode_plan.md 2 단계). 앞 범퍼 아래 받침 하나에 좌우 ±20°·위 5° (hardware/mounts print_sonar, docs/wiring.md).
       자리는 잠정 — 받침 조립 그림(hardware/mounts/limo_mounts.png)에서 읽은 값이고 실측 아님: 범퍼 앞 0.18 m, 가운데서 ±0.025 m(보드 폭 45 mm 둘),
       높이 base_link −0.06 m = 바닥 위 약 0.085 m. 시뮬 LimoFire.proto ultrasonic 과 같은 값 -->
  <xacro:ultrasonic parent="base_link" name="ultrasonic_front_left" xyz="0.18 0.025 -0.06" yaw="${20*pi/180}" pitch="${-5*pi/180}"/>
  <xacro:ultrasonic parent="base_link" name="ultrasonic_front_right" xyz="0.18 -0.025 -0.06" yaw="${-20*pi/180}" pitch="${-5*pi/180}"/>

  <!-- Webots 바퀴 구동 (webots_control.xacro) -->
  <xacro:if value="${'$(arg platform)' == 'webots'}">
    <xacro:webots_control/>
  </xacro:if>
</robot>
