<!-- Webots 시뮬 로봇 켜기 = 실물 robot.launch.xml 의 시뮬 판. 이 뒤에 붙는 지도·Nav2·인식은 실물과 같은 launch 를 쓴다
     실물 드라이버(바퀴·IMU·라이다·카메라)와 EKF 자리를 Webots 가 대신한다:
       교수님 limo_sensors 플러그인(webots_ros2_limo)이 실물과 같은 토픽·프레임으로 /scan /imu /odom /camera/* 와
       odom → base_link (실물은 EKF), camera_link → color·depth 프레임 (실물은 Orbbec 드라이버) TF 를 낸다.
     로봇 모델 TF 는 실물과 같은 우리 URDF(limo_fire_description, platform:=webots)에서 낸다.
     교수님 robot_launch.py 를 쓰지 않는 까닭: 드라이버가 로봇 모델을 robot_state_publisher 에 1 초만 기다려 넘겨서
     두 번에 한 번꼴로 TF 가 안 나왔다(URDF 경쟁). 여기서는 그 경로를 끄고(set_robot_state_publisher false) 우리 URDF 를 쓴다.
     월드 파일에는 /clock 을 내는 Ros2Supervisor 로봇이 들어 있어야 한다 (sim/webots/README.md)
     ros2 launch limo_fire_bringup sim_robot.launch.xml world_file:=<월드.wbt 절대경로> -->
<launch>
  <arg name="world_file"/>
  <arg name="mode" default="realtime" description="Webots 실행 모드: realtime · fast · pause"/>
  <arg name="port" default="1234"/>
  <arg name="limo_share" default="$(find-pkg-share webots_ros2_limo)" description="교수님 Webots LIMO 패키지 (ros2_control 설정)"/>
  <arg name="driver_urdf" default="$(find-pkg-share limo_fire_sim)/resource/limo_webots.urdf"
       description="드라이버 설정: 교수님 limo.urdf 에 인식 벤치마크 정답 카메라(/gt/*)를 더한 우리 판"/>

  <!-- Webots. 창을 닫으면 launch 전체가 끝난다 -->
  <executable cmd="$(env WEBOTS_HOME)/webots --port=$(var port) --batch --mode=$(var mode) $(var world_file)"
              name="webots" output="screen" on_exit="shutdown"/>

  <!-- /clock (Webots 시각). 월드 안 Ros2Supervisor 로봇의 컨트롤러 -->
  <node pkg="webots_ros2_driver" exec="ros2_supervisor.py" namespace="Ros2Supervisor" output="screen" respawn="true">
    <env name="WEBOTS_CONTROLLER_URL" value="ipc://$(var port)/Ros2Supervisor"/>
    <env name="WEBOTS_HOME" value="$(find-pkg-prefix webots_ros2_driver)"/>
    <remap from="/Ros2Supervisor/clock" to="/clock"/>
  </node>

  <!-- LIMO 컨트롤러: 센서 플러그인 + ros2_control(바퀴). Webots 가 월드를 다 읽을 때까지 스스로 기다린다 -->
  <executable name="webots_controller_LIMO" output="screen" respawn="true"
              cmd="$(find-pkg-share webots_ros2_driver)/scripts/webots-controller --robot-name=LIMO --protocol=ipc --port=$(var port) ros2 --ros-args
                   -p robot_description:=$(var driver_urdf) -p use_sim_time:=true -p set_robot_state_publisher:=false
                   -r /diffdrive_controller/cmd_vel_unstamped:=/cmd_vel --params-file $(var limo_share)/resource/diff/ros2control.yaml">
    <env name="WEBOTS_HOME" value="$(find-pkg-prefix webots_ros2_driver)"/>
  </executable>

  <!-- 컨트롤러 매니저가 뜰 때까지 기다렸다가 바퀴 제어·관절 상태를 켠다 -->
  <node pkg="controller_manager" exec="spawner" args="diffdrive_controller --controller-manager-timeout 120" output="screen"/>
  <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster --controller-manager-timeout 120" output="screen"/>

  <!-- 로봇 모델 TF (바퀴 관절 상태는 joint_state_broadcaster 가 낸다) -->
  <include file="$(find-pkg-share limo_fire_description)/launch/description.launch.xml">
    <arg name="platform" value="webots"/>
    <arg name="camera_driver_tf" value="true"/>
    <arg name="joint_states" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>
</launch>
