<!-- 실물 LIMO 를 한 번에 (sim.launch.xml 의 실물판 — 인자 이름이 같다):
       로봇(센서·섀시·EKF) + (저장 지도·AMCL 또는 Cartographer 지도 만들기) + Nav2 + 인식(화재 모델) + 운용 화면 하나
     순찰 (저장 지도):  ros2 launch limo_fire_bringup real.launch.xml
                        → RViz 2D Pose Estimate → Publish Point 로 점 찍기 → ros2 service call /click_patrol/start std_srvs/srv/Trigger
     연기 모드 (저장 지도): 2D Pose Estimate 로 위치를 잡은 뒤 RViz Smoke 패널 버튼 → 라이다·카메라 없이 바퀴 + IMU 로만 주행 → Nav2 Goal
     임무 BT 까지:      ros2 launch limo_fire_bringup real.launch.xml bt:=true
     탐사 (새 곳):      ros2 launch limo_fire_bringup real.launch.xml slam:=true
                        → 리모컨 SWB 위 → RViz 탐사 패널 "Auto explore" 버튼 → 다 돌면 save_map.launch.xml name:=<이름>
     주행을 내는 것(임무 BT · click_patrol · 탐사)은 하나만 쓴다 — 둘이 같이 내면 서로 끊는다 (탐사는 Nav2 없이 /cmd_vel 을 바로 냄).
     탐사 노드와 찍어서 순찰(click_patrol)은 인자 없이 늘 멈춘 채 떠 있다 — 탐사는 탐사 패널 버튼, click_patrol 은
     RViz Publish Point 로 찍고(지도에 번호·선) ~/start 로 출발. 임무 BT(bt:=true)는 기본 순찰점이 없고 이 찍은 점(/patrol/route)으로만 순찰한다 —
     찍기 전에는 기다리고, 찍거나 지우면 다음 순찰점부터 바뀐다. 셋 중 하나만 출발시킨다 (임무 BT 가 순찰 중이면 click_patrol ~/start·탐사 버튼은 쓰지 않는다). 저장 지도(slam:=false)는 이미 닫혀 있어 탐사가 곧 끝난다, 새 곳은 slam:=true
     대시보드 limo_base 나 robot.launch.xml 을 따로 켜 두었으면 robot:=false (섀시 포트는 드라이버 하나만) -->
<launch>
  <arg name="robot" default="true" description="센서·섀시·EKF (robot.launch.xml). 따로 켜 두었으면 false"/>
  <arg name="slam" default="false" description="true: 저장 지도·AMCL 대신 Cartographer 로 지도를 만들며 주행 (새 곳 탐사)"/>
  <arg name="map" default="$(find-pkg-share limo_fire_navigation)/maps/lab_1116b.yaml" description="slam:=false 일 때 쓰는 지도"/>
  <arg name="explore" default="true" description="합친 탐사(시뮬과 같은 코드)를 멈춘 채 늘 띄운다 — RViz 탐사 패널 버튼으로 언제든 켜고 끔"/>
  <arg name="bt" default="false" description="임무 BT (순찰·불 대응). 켜면 리모컨 오토가 되자마자 순찰한다 — 그동안 click_patrol·탐사는 출발시키지 않는다"/>
  <arg name="patrol_file" default="" description="임무 BT 순찰점 파일. 비면(기본) RViz Publish Point 로 찍은 점만 순찰하고, 찍기 전에는 기다린다"/>
  <arg name="decider" default="false" description="true: 탐사 위층 판단 모델(로봇 안 llama-server 를 먼저 띄움 — limo_fire_explore README) · false: 규칙으로 후보 고름"/>
  <arg name="perception" default="true" description="YOLO 화재 모델 탐지 + 물체 지도"/>
  <arg name="perception_override" default="$(find-pkg-share limo_fire_perception)/config/yolo_fire.yaml"
       description="인식 설정 덮어쓰기 (예: 이 기기에 있는 엔진 경로만 바꾼 yaml)"/>
  <arg name="rviz" default="true"/>

  <!-- 통신 설정 확인: 이 워크스페이스의 env.sh 를 불러온 셸이어야 Fast DDS 공유 메모리 칸이 4 MB 다 (기본 512 KB 는 영상 한 장보다 작아
       카메라가 30 Hz 로 내도 YOLO·물체 지도·BT 가 장을 놓친다 — 2026-11-20 실물에서 컬러 30 Hz 를 내는데 YOLO 18.8 장/초).
       변수가 없으면 여기서 멈춘다: 'source ~/<이 워크스페이스>/env.sh' 후 다시 -->
  <let name="dds_profile" value="$(env FASTRTPS_DEFAULT_PROFILES_FILE)"/>

  <!-- include 에 준 인자는 Humble 에서 바깥으로 새어 나와 다음 include 의 값을 바꾸므로 하나씩 group 으로 가둔다 -->
  <group if="$(var robot)">
    <include file="$(find-pkg-share limo_fire_bringup)/launch/robot.launch.xml"/>
  </group>

  <group if="$(var slam)">
    <include file="$(find-pkg-share limo_fire_bringup)/launch/mapping.launch.xml">
      <arg name="rviz" value="false"/>
    </include>
  </group>

  <group>
    <include file="$(find-pkg-share limo_fire_bringup)/launch/navigation.launch.xml">
      <arg name="map" value="$(var map)"/>
      <arg name="localization" value="$(not $(var slam))"/>
      <arg name="rviz" value="false"/>
    </include>
  </group>

  <!-- 탐사는 시뮬과 같은 코드의 합친 탐사(/explore/explorer: 지역 계획기 · 깊이 카메라 층 · 막힘 처리, Nav2 안 씀 — limo_fire_explore README).
       멈춘 채 뜨고 RViz 탐사 패널 버튼(/explore/enable)으로 켬. 인식은 아래 perception 이 따로 띄움 -->
  <group if="$(var explore)">
    <include file="$(find-pkg-share limo_fire_explore)/launch/app.launch.xml">
      <arg name="stack" value="false"/>
      <arg name="rviz" value="false"/>
      <arg name="debug" value="true"/>
      <arg name="perception" value="false"/>
      <arg name="dry_run" value="false"/>
      <arg name="decider" value="$(var decider)"/>
    </include>
  </group>

  <!-- 찍어서 순찰: 늘 띄운다 (점 찍기·지도 표시용, ~/start 전까지 움직이지 않음) -->
  <group>
    <include file="$(find-pkg-share limo_fire_bt)/launch/click_patrol.launch.xml"/>
  </group>

  <group if="$(var perception)">
    <include file="$(find-pkg-share limo_fire_perception)/launch/perception.launch.xml">
      <arg name="config" value="yolo_fire.yaml"/>
      <arg name="params_override" value="$(var perception_override)"/>
      <arg name="rviz" value="false"/>
    </include>
  </group>

  <!-- 화면은 하나: 지도·Nav2·순찰점·탐사·물체·YOLO·임무 현황판 -->
  <group if="$(var rviz)">
    <include file="$(find-pkg-share limo_fire_description)/launch/viewer.launch.xml"/>
  </group>

  <group if="$(var bt)">
    <include file="$(find-pkg-share limo_fire_bt)/launch/bt.launch.xml">
      <arg name="patrol_file" value="$(var patrol_file)"/>
    </include>
  </group>
</launch>
