<!-- Webots 시뮬을 한 번에: 로봇 + (Cartographer 지도 만들기 또는 저장 지도·AMCL) + Nav2 [+ YOLO·물체 지도]
     실물과 같은 launch(mapping · navigation · yolo)에 시뮬 차이만 인자로 준다. 로봇 켜기만 sim_robot.launch.xml 로 다르다.
     맵은 이름 하나로 고른다. 새 맵은 같은 이름으로 파일만 넣으면 되고 이 파일은 고치지 않는다 (sim/webots/README.md):
       월드  sim/webots/worlds/<world>.wbt        (정답 물체·순찰점은 같은 자리 <world>.yaml)
       지도  limo_fire_navigation/maps/sim/<world>.yaml
     주행:        ros2 launch limo_fire_bringup sim.launch.xml world:=limo_fire_maze
     지도 만들기: ros2 launch limo_fire_bringup sim.launch.xml world:=limo_fire_maze slam:=true
                  (프론티어 탐사 노드가 멈춘 채 같이 뜬다 — RViz 탐사 패널 "Auto explore" 버튼으로 켜고 끔. explore:=false 면 안 띄움)
                  → 다 돌았으면 ros2 launch limo_fire_bringup save_map.launch.xml name:=sim/limo_fire_maze
     Nav2 는 TF·/clock·지도가 준비될 때까지 스스로 기다리므로 시간 지연을 두지 않는다 -->
<launch>
  <arg name="world" default="limo_fire_world" description="sim/webots/worlds/ 안 월드 이름 (확장자 없이)"/>
  <arg name="world_dir" default="$(env HOME)/limo_fire_ws/sim/webots/worlds"/>
  <arg name="slam" default="false" description="true: 저장 지도·AMCL 대신 Cartographer 로 지도를 만들며 주행"/>
  <arg name="nav" default="true" description="Nav2 를 띄운다"/>
  <arg name="map" default="$(find-pkg-share limo_fire_navigation)/maps/sim/$(var world).yaml" description="slam:=false 일 때 쓰는 지도"/>
  <arg name="explore" default="$(var slam)" description="프론티어 탐사 노드를 멈춘 채(idle) 띄운다 — RViz 탐사 패널 버튼·/explore_frontier/enable 로 켬. 기본은 slam 과 같음"/>
  <arg name="perception" default="false" description="YOLO 탐지 + 물체 지도 (limo_fire_perception yolo.launch.xml)"/>
  <arg name="benchmark" default="false"
       description="인식 벤치마크: 인식을 켜고 정답(/gt/*)과 비교해 끝낼 때 docs/benchmarks/ 에 표를 쓴다. 로봇은 따로 움직인다(RViz 목표·순찰)"/>
  <arg name="report_dir" default="$(env HOME)/limo_fire_ws/docs/benchmarks"/>
  <arg name="rviz" default="true"/>
  <arg name="mode" default="realtime" description="Webots 실행 모드: realtime · fast · pause"/>
  <arg name="port" default="1234" description="Webots 포트 — 한 컴퓨터에서 시뮬을 둘 띄울 때 다르게"/>

  <!-- include 에 준 인자는 Humble 에서 바깥으로 새어 나와 다음 include 의 값을 바꾸므로 하나씩 group 으로 가둔다 -->
  <group>
    <include file="$(find-pkg-share limo_fire_bringup)/launch/sim_robot.launch.xml">
      <arg name="world_file" value="$(var world_dir)/$(var world).wbt"/>
      <arg name="mode" value="$(var mode)"/>
      <arg name="port" value="$(var port)"/>
    </include>
  </group>

  <group if="$(var slam)">
    <include file="$(find-pkg-share limo_fire_bringup)/launch/mapping.launch.xml">
      <arg name="odom_topic" value="/odom"/>
      <arg name="use_sim_time" value="true"/>
      <arg name="rviz" value="false"/>
    </include>
  </group>

  <group if="$(var nav)">
    <include file="$(find-pkg-share limo_fire_bringup)/launch/navigation.launch.xml">
      <arg name="map" value="$(var map)"/>
      <arg name="params_override" value="$(find-pkg-share limo_fire_navigation)/config/nav2_sim.yaml"/>
      <arg name="use_sim_time" value="true"/>
      <arg name="localization" value="$(not $(var slam))"/>
      <arg name="rviz" value="false"/>
    </include>
  </group>

  <group if="$(var explore)">
    <include file="$(find-pkg-share limo_fire_rl)/launch/explore_frontier.launch.xml">
      <arg name="use_sim_time" value="true"/>
    </include>
  </group>

  <group if="$(or $(var perception) $(var benchmark))">
    <include file="$(find-pkg-share limo_fire_perception)/launch/yolo.launch.xml">
      <arg name="use_sim_time" value="true"/>
      <arg name="rviz" value="false"/>
      <arg name="params_override" value="$(find-pkg-share limo_fire_perception)/config/$(if $(var benchmark) benchmark.yaml yolo_fire.yaml)"/>
    </include>
  </group>

  <node pkg="limo_fire_perception" exec="perception_benchmark" name="perception_benchmark" output="screen" if="$(var benchmark)">
    <param from="$(find-pkg-share limo_fire_perception)/config/yolo_fire.yaml"/>
    <param name="world_file" value="$(var world_dir)/$(var world).yaml"/>
    <param name="report_dir" value="$(var report_dir)"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- 화면은 하나: 지도·Nav2·물체·YOLO 를 같이 본다 -->
  <group if="$(var rviz)">
    <include file="$(find-pkg-share limo_fire_description)/launch/viewer.launch.xml">
      <arg name="use_sim_time" value="true"/>
    </include>
  </group>
</launch>
