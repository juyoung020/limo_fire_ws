<!-- Cartographer 로 지도 만들기 (대시보드 "맵" = WeGo wego/cartographer_launch.py 와 같은 구성)
     먼저 robot.launch.xml 을 켜 둔다. 다 돌았으면 save_map.launch.xml 로 저장
     ros2 launch limo_fire_bringup mapping.launch.xml [rviz:=false]
     시뮬은 sim.launch.xml 이 이 파일을 그대로 쓴다 (odom_topic:=/odom use_sim_time:=true) -->
<launch>
  <arg name="configuration_directory" default="$(find-pkg-share limo_fire_navigation)/config"/>
  <arg name="configuration_basename" default="cartographer_2d.lua"/>
  <arg name="resolution" default="0.05" description="지도 한 칸 크기(m)"/>
  <arg name="publish_period_sec" default="1.0" description="/map 발행 주기(s)"/>
  <arg name="odom_topic" default="odometry/filtered" description="오도메트리 토픽. 실물은 EKF 출력, Webots 는 플러그인이 EKF 자리에서 내는 /odom"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz" default="true"/>

  <node pkg="cartographer_ros" exec="cartographer_node" name="cartographer_node" output="screen"
        args="-configuration_directory $(var configuration_directory) -configuration_basename $(var configuration_basename)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="odom" to="$(var odom_topic)"/>
  </node>

  <node pkg="cartographer_ros" exec="cartographer_occupancy_grid_node" name="cartographer_occupancy_grid_node" output="screen"
        args="-resolution $(var resolution) -publish_period_sec $(var publish_period_sec)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <include file="$(find-pkg-share limo_fire_description)/launch/viewer.launch.xml" if="$(var rviz)">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>
</launch>
