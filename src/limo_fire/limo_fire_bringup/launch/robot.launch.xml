<!-- 실물 LIMO Pro 센서·구동 켜기 (대시보드 "센서" = WeGo wego/teleop_launch.py 와 같은 구성)
     ros2 launch limo_fire_bringup robot.launch.xml [viz:=true] [camera_pitch:=0.1152] [base:=false] [esp32:=true]
     URDF(limo_fire_description, 카메라 장착 포함) + 섀시(limo_fire_base: 바퀴·IMU·리모컨) + 깊이 카메라 + 라이다 + EKF
     base:=false 는 센서만(베이스·EKF 끔): 충전 중이나 세워 두고 센서 오차를 잴 때 — 바퀴가 명령을 받지 않는다 -->
<launch>
  <arg name="camera_pitch" default="0.1152" description="카메라 마운트 틸트 pitch (라디안, 아래로 숙이면 +). 기본값은 실측 6.6° (real_limo.md 깊이 절)"/>
  <arg name="viz" default="false"/>
  <arg name="base" default="true" description="false 면 베이스(바퀴·IMU)·EKF 를 켜지 않고 센서만"/>
  <arg name="max_clocks" default="true" description="jetson_clocks 로 CPU·GPU·메모리 클럭을 최대로 고정 (재부팅하면 풀림, sudo 암호 없이 될 때만)"/>
  <arg name="esp32" default="false" description="ESP32 다리(초음파 HC-SR04 × 3 → /ultrasonic/*). 초음파·ESP32 를 단 뒤 true (limo_fire_esp32_bridge README)"/>

  <!-- 클럭 고정: 카메라처럼 33 ms 마다 한 장이면 장 사이에 GPU 클럭이 내려가 YOLO 가 21 ms → 고정하면 11 ms -->
  <executable cmd="sudo -n /usr/bin/jetson_clocks" name="jetson_clocks" output="screen" if="$(var max_clocks)"/>

  <!-- 로봇 모델: 센서 장착 위치는 전부 URDF 에. camera_link 아래 color·depth 프레임은 Orbbec 드라이버가 낸다(publish_tf) -->
  <include file="$(find-pkg-share limo_fire_description)/launch/description.launch.xml">
    <arg name="platform" value="real"/>
    <arg name="camera_pitch" value="$(var camera_pitch)"/>
    <arg name="camera_driver_tf" value="true"/>
    <arg name="joint_states" value="true"/>
  </include>

  <!-- 섀시: /cmd_vel 받음, 바퀴 오도메트리 /odom, IMU /imu, 상태 /limo_status, 리모컨 /rc_state, 모터 /motor_states, 바퀴 거리 /wheel_odometry.
       odom TF 는 EKF 가 낸다. limo_fire_base = WeGo limo_base 그대로 + 버리던 리모컨·모터·바퀴 거리 -->
  <node pkg="limo_fire_base" exec="limo_fire_base" name="limo_fire_base" namespace="limo" output="screen" emulate_tty="true" if="$(var base)">
    <param from="$(find-pkg-share limo_fire_bringup)/config/limo_base.yaml"/>
  </node>

  <!-- 깊이 카메라 Orbbec Dabai DC1 -->
  <group>
    <push_ros_namespace namespace="camera"/>
    <node_container pkg="rclcpp_components" exec="component_container" name="camera_container" namespace="" output="screen">
      <composable_node pkg="orbbec_camera" plugin="orbbec_camera::OBCameraNodeDriver" name="camera" namespace="">
        <param from="$(find-pkg-share limo_fire_bringup)/config/orbbec_dabai_dc1.yaml"/>
        <!-- 프로세스 안 전달(use_intra_process_comms)은 못 켠다: 드라이버가 transient_local 발행자(depth_to_color 등)를 만들어 rclcpp 가 거부 -->
      </composable_node>
    </node_container>
  </group>

  <!-- 라이다 YDLIDAR T-mini Plus -->
  <node pkg="ydlidar_ros2_driver" exec="ydlidar_ros2_driver_node" name="ydlidar_ros2_driver_node" namespace="/" output="screen" emulate_tty="true">
    <param from="$(find-pkg-share limo_fire_bringup)/config/ydlidar.yaml"/>
  </node>

  <!-- ESP32: 초음파 HC-SR04 × 3 → /ultrasonic/front·left·right (sensor_msgs/Range). 펌웨어 firmware/limo_fire_esp32 -->
  <node pkg="limo_fire_esp32_bridge" exec="esp32_bridge" name="esp32_bridge" output="screen" if="$(var esp32)">
    <param from="$(find-pkg-share limo_fire_esp32_bridge)/config/esp32_bridge.yaml"/>
  </node>

  <!-- EKF: /odom + /imu → /odometry/filtered, odom → base_link -->
  <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node_odom" output="screen" if="$(var base)">
    <param from="$(find-pkg-share limo_fire_bringup)/config/ekf.yaml"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" if="$(var viz)"
        args="-d $(find-pkg-share limo_fire_description)/rviz/sensors.rviz"/>
</launch>
