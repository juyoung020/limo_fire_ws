<!-- 임무 BT (limo_fire_bt README). 주행 스택(Nav2)·센서·인식이 먼저 떠 있어야 하지만,
     안 떠 있으면 트리가 PreflightSensors 에서 기다리며 SENSOR_FAULT 를 알린다.
     ros2 launch limo_fire_bt bt.launch.xml patrol_file:=<순찰점 yaml> [sim:=true] -->
<launch>
  <arg name="sim" default="false" description="true: limo_fire_bt_sim.yaml 덮어쓰기 + 시뮬 시계"/>
  <arg name="patrol_file" default="" description="순찰점 yaml (patrol: [[x, y], ...]; robot_start 가 있으면 세계 좌표)"/>
  <arg name="tree_file" default="$(find-pkg-share limo_fire_bt)/behavior_trees/limo_fire_bt.xml"/>
  <arg name="btlog_dir" default="" description="비어 있지 않으면 판마다 .btlog"/>
  <!-- 시뮬이면 limo_fire_bt_sim.yaml 을 덮는다. 실물이면 같은 파일을 한 번 더 읽어 덮을 것이 없다 -->
  <let name="override" value="$(find-pkg-share limo_fire_bt)/config/limo_fire_bt_sim.yaml" if="$(var sim)"/>
  <let name="override" value="$(find-pkg-share limo_fire_bt)/config/limo_fire_bt.yaml" unless="$(var sim)"/>

  <node pkg="limo_fire_bt" exec="mission" name="mission" output="screen">
    <param from="$(find-pkg-share limo_fire_bt)/config/limo_fire_bt.yaml"/>
    <param from="$(var override)"/>
    <param name="tree_file" value="$(var tree_file)"/>
    <param name="patrol_file" value="$(var patrol_file)"/>
    <param name="btlog_dir" value="$(var btlog_dir)"/>
    <param name="use_sim_time" value="$(var sim)"/>
  </node>
</launch>
