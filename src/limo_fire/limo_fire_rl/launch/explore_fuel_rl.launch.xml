<!-- 합친 탐사 실물 — 기본은 확정 구성: 위층 판단 모델(decider) + 아래층 A* 경로 계획(rule) (2026-11-16 실물 시험으로 정함, limo_fire_rl/README "합친 탐사 low_rl").
     판단 모델 서버(llama-server)를 먼저 띄운다 (README). 먼저 robot.launch.xml (센서·섀시·EKF) 를 켜 둔다.
     ros2 launch limo_fire_rl explore_fuel_rl.launch.xml [dry_run:=true|false] [stack:=true] [rviz:=true] [upper:=decider|fuel|slot0] [perception:=true]
     perception:=true 면 YOLO 분할(기본 COCO 80 종, perception_config) + 물체 지도를 같이 띄워 찾은 물체가 지도 위에 모양·이름으로 남는다
     stack:=true 면 Cartographer(mapping.launch.xml — 지도 TF map → base_link)를 같이 띄운다. Nav2 는 안 쓴다 (아래층 A* 경로 추종이 바로 /cmd_vel).
     아래층 강화학습은 2026-11-16 에 그만둠 (archive/rl/README.md).
     늘 꺼진 채 뜬다 → RViz 탐사 패널 "합친 탐사 (/low_rl)" 또는 ros2 service call /low_rl/enable std_srvs/srv/SetBool "{data: true}" (리모컨 오토일 때만 켜짐) -->
<launch>
  <arg name="dry_run" default="true" description="true: /cmd_vel 안 냄 (~/cmd_debug 에만) · false: 실제 주행"/>
  <arg name="stack" default="false" description="true: Cartographer 같이"/>
  <arg name="rviz" default="false" description="true: 운용 화면 RViz (rviz/explore_fuel_rl.rviz — 탐사 패널 /low_rl)"/>
  <arg name="map_frame" default="map"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="record" default="" description="입력·관측·명령 녹화 파일 (비우면 안 씀)"/>
  <arg name="upper" default="decider" description="위층: fuel · slot0 (피하지 않는 가장 가까운 후보 — A/B 용) · decider (로봇 안 llama-server 판단 모델을 먼저 띄움 — limo_fire_rl/README)"/>
  <arg name="decider_url" default="http://127.0.0.1:8171"/>
  <arg name="decider_period" default="3.0" description="upper:=decider 요청 주기 (s) — 로봇에서 잰 답 시간 + 여유"/>
  <arg name="perception" default="false" description="true: YOLO 분할 + 물체 지도(object_mapper) — 찾은 물체가 RViz 지도 위에 모양·이름과 함께 남음"/>
  <arg name="perception_config" default="yolo_coco.yaml" description="인식 모델 설정 (limo_fire_perception/config): yolo_coco.yaml (COCO 80 종) · yolo_fire.yaml (화재 7 종)"/>
  <arg name="objects_file" default="" description="물체 지도 파일 (있으면 켤 때 읽음)"/>

  <group if="$(var stack)">
    <include file="$(find-pkg-share limo_fire_bringup)/launch/mapping.launch.xml">
      <arg name="rviz" value="false"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>

  <!-- 물체 지도: 탐지 + 깊이 → 지도 위 물체 (/object_mapper/markers 를 이 launch 의 RViz 가 그림). 운용 화면은 아래 것을 쓰므로 rviz:=false -->
  <group if="$(var perception)">
    <include file="$(find-pkg-share limo_fire_perception)/launch/yolo.launch.xml">
      <arg name="rviz" value="false"/>
      <arg name="config" value="$(var perception_config)"/>
          <arg name="objects_file" value="$(var objects_file)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
    <!-- "○○ 로 가" (탐사 중): 물체 지도에 있으면 그 옆 설 자리를 low_rl ~/goto 로, 없으면 low_rl ~/instruction 으로 찾으며 탐사.
         ros2 topic pub -1 /object_goto/goal std_msgs/msg/String "{data: '의자'}" · 빈 글이면 지시 지움 · 상태 /object_goto/status, /low_rl/goto_status -->
    <node pkg="limo_fire_navigation" exec="object_goto" name="object_goto" output="screen">
      <param from="$(find-pkg-share limo_fire_navigation)/config/object_goto.yaml"/>
      <param name="mode" value="explore"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>

  <!-- 운용 화면은 limo_fire.rviz 와 같되 탐사 패널이 /low_rl, 목표 표시가 /low_rl/goal_marker 인 이 launch 전용 설정 -->
  <node pkg="rviz2" exec="rviz2" name="limo_fire_rviz" output="screen" if="$(var rviz)"
        args="-d $(find-pkg-share limo_fire_rl)/rviz/explore_fuel_rl.rviz">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <include file="$(find-pkg-share limo_fire_rl)/launch/low_rl.launch.xml">
    <arg name="dry_run" value="$(var dry_run)"/>
    <arg name="map_frame" value="$(var map_frame)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="record" value="$(var record)"/>
    <arg name="upper" value="$(var upper)"/>
    <arg name="decider_url" value="$(var decider_url)"/>
    <arg name="decider_period" value="$(var decider_period)"/>
  </include>
</launch>
