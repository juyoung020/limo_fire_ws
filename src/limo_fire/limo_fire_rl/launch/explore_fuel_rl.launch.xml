<!-- 합친 탐사 실물 (위층 fuel + 아래층 순수 RL — limo_fire_rl/README "합친 탐사 low_rl"). 먼저 robot.launch.xml (센서·섀시·EKF) 를 켜 둔다.
     ros2 launch limo_fire_rl explore_fuel_rl.launch.xml [checkpoint:=~/ckpt/low_w3_36000.bin] [dry_run:=true|false] [stack:=true] [rviz:=true] [upper:=fuel|slot0|decider]
     stack:=true 면 Cartographer(mapping.launch.xml — 지도 TF map → base_link)를 같이 띄운다. Nav2 는 안 쓴다 (아래층 RL 이 바로 /cmd_vel).
     늘 꺼진 채 뜬다 → RViz 탐사 패널 "fuel + 아래층 RL (/low_rl)" 또는 ros2 service call /low_rl/enable std_srvs/srv/SetBool "{data: true}" (리모컨 오토일 때만 켜짐) -->
<launch>
  <arg name="checkpoint" default="$(env HOME)/ckpt/low_w3_36000.bin" description="아래층 체크포인트 .bin (low_w3 반복 36000)"/>
  <arg name="dry_run" default="true" description="true: /cmd_vel 안 냄 (~/cmd_debug 에만) · false: 실제 주행"/>
  <arg name="stack" default="false" description="true: Cartographer 같이"/>
  <arg name="rviz" default="false" description="true: 운용 화면 RViz (rviz/explore_fuel_rl.rviz — 탐사 패널 /low_rl)"/>
  <arg name="map_frame" default="map"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="record" default="" description="입력·관측·명령 녹화 파일 (비우면 안 씀)"/>
  <arg name="upper" default="fuel" description="위층: fuel · slot0 (피하지 않는 가장 가까운 후보 — A/B 용) · decider (로봇 안 llama-server 판단 모델을 먼저 띄움 — limo_fire_rl/README)"/>
  <arg name="decider_url" default="http://127.0.0.1:8171"/>
  <arg name="decider_period" default="3.0" description="upper:=decider 요청 주기 (s) — 로봇에서 잰 답 시간 + 여유"/>

  <group if="$(var stack)">
    <include file="$(find-pkg-share limo_fire_bringup)/launch/mapping.launch.xml">
      <arg name="rviz" value="false"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>

  <!-- 운용 화면은 limo_fire.rviz 와 같되 탐사 패널이 /low_rl, 목표 표시가 /low_rl/goal_marker 인 이 launch 전용 설정 -->
  <node pkg="rviz2" exec="rviz2" name="limo_fire_rviz" output="screen" if="$(var rviz)"
        args="-d $(find-pkg-share limo_fire_rl)/rviz/explore_fuel_rl.rviz">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <include file="$(find-pkg-share limo_fire_rl)/launch/low_rl.launch.xml">
    <arg name="checkpoint" value="$(var checkpoint)"/>
    <arg name="dry_run" value="$(var dry_run)"/>
    <arg name="map_frame" value="$(var map_frame)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="record" value="$(var record)"/>
    <arg name="upper" value="$(var upper)"/>
    <arg name="decider_url" value="$(var decider_url)"/>
    <arg name="decider_period" value="$(var decider_period)"/>
  </include>
</launch>
