<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>limo_fire_rl</name>
  <version>0.1.0</version>
  <description>탐사 노드: RL 정책(학습 시뮬과 같은 관측 코드로 1 s 마다 프론티어 후보 하나를 Nav2 목표로)과 프론티어 탐사(탐사 기준선과 같은 찾기·고르기)</description>
  <maintainer email="151780134+juyoung020@users.noreply.github.com">김주영</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>
  <exec_depend>limo_fire_navigation</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
