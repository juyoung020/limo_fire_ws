WorldInfo {
  info [
    "AgileX LIMO in the Cyberbotics webots_ros2_turtlebot apartment world."
    "limo_fire: 교수님 limo_world.wbt 에 YOLO 7 클래스 물체를 놓은 판 (sim/webots/README.md, objects.yaml)"
  ]
  title "ROS2 simulation of the AgileX LIMO robot"
  basicTimeStep 10
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "default"
      coulombFriction 1.0
      forceDependentSlip 0.01
      bounce 0
    }
  ]
}
