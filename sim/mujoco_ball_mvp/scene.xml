<mujoco model="ball_topple_mvp">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global azimuth="135" elevation="-22"/>
    <scale contactwidth="0.08" contactheight="0.05"/>
  </visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.84 0.85 0.86" rgb2="0.67 0.70 0.74"/>
    <material name="floor" texture="grid" texrepeat="6 6" reflectance="0.05"/>
    <mesh name="limo_base_mesh" file="assets/limo/limo_base_visual.stl" scale="0.001 0.001 0.001"/>
    <mesh name="limo_wheel_mesh" file="assets/limo/limo_wheel.stl" scale="0.001 0.001 0.001"/>
  </asset>
  <worldbody>
    <light pos="0 -2 3" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="ground" type="plane" size="5 5 0.1" material="floor" friction="1.2 0.1 0.01"/>
    <!-- Visual-only LIMO chassis replaces the blue launch placeholder; it adds no collision or dynamics. -->
    <body name="limo_visual_root" pos="-0.22 0 0">
      <body name="limo_chassis_visual">
        <geom name="limo_base_visual" type="mesh" mesh="limo_base_mesh" euler="0 0 90" rgba="0.20 0.23 0.27 1" contype="0" conaffinity="0" density="0"/>
      </body>
      <body name="limo_wheel_front_left_visual" pos="0.100 0.065 0.050">
        <geom type="mesh" mesh="limo_wheel_mesh" rgba="0.07 0.08 0.09 1" contype="0" conaffinity="0" density="0"/>
      </body>
      <body name="limo_wheel_front_right_visual" pos="0.100 -0.065 0.050" euler="180 0 0">
        <geom type="mesh" mesh="limo_wheel_mesh" rgba="0.07 0.08 0.09 1" contype="0" conaffinity="0" density="0"/>
      </body>
      <body name="limo_wheel_rear_left_visual" pos="-0.100 0.065 0.050">
        <geom type="mesh" mesh="limo_wheel_mesh" rgba="0.07 0.08 0.09 1" contype="0" conaffinity="0" density="0"/>
      </body>
      <body name="limo_wheel_rear_right_visual" pos="-0.100 -0.065 0.050" euler="180 0 0">
        <geom type="mesh" mesh="limo_wheel_mesh" rgba="0.07 0.08 0.09 1" contype="0" conaffinity="0" density="0"/>
      </body>
    </body>
    <geom name="muzzle_marker" type="cylinder" pos="-0.03 0 0.30" size="0.055 0.10" euler="0 90 0" rgba="0.2 0.2 0.23 1" contype="0" conaffinity="0"/>
    <body name="ball" pos="0 0 0.3">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.055" mass="0.10" rgba="0.13 0.55 0.96 1" friction="0.8 0.01 0.001"/>
    </body>
    <!-- Tip-over target rotates around a fixed ground hinge, avoiding false "sliding" success. -->
    <!-- 8 cm elevated fixed hinge: 7.5 cm half-thickness needs clearance to rotate.
         The old 2 cm pivot trapped the lower corner against the ground at 15.47 deg.
         Ground collision, dimensions, mass, damping and friction remain unchanged. -->
    <body name="fire_target" pos="1.25 0 0.08">
      <joint name="target_hinge" type="hinge" axis="0 1 0" limited="true" range="-115 115" damping="0.02" frictionloss="0.002"/>
      <geom name="target_hitbox" type="box" pos="0 0 0.23" size="0.075 0.09 0.23" mass="0.14" rgba="0.91 0.20 0.12 1" friction="1 0.1 0.01"/>
      <geom name="flame_visual" type="ellipsoid" pos="0 0 0.38" size="0.065 0.075 0.10" density="0" contype="0" conaffinity="0" rgba="1 0.72 0.07 0.9"/>
    </body>
    <camera name="overview" pos="2 -3 1.6" xyaxes="0.83 0.55 0 -0.16 0.25 0.95"/>
  </worldbody>
</mujoco>
